SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///dynamic_learning.sqlite3
FLASK_APP=run.py
FLASK_DEBUG=0
# Development convenience only. Keep disabled in production.
APP_ENV=development
ENABLE_DEMO_ACCOUNT=1

# Optional live AI quiz generation (OpenAI-compatible Chat Completions API).
# Leave AI_API_KEY empty to use the built-in offline AI question generator.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=25
AI_QUIZ_DEFAULT_LENGTH=10
AI_QUIZ_MAX_LENGTH=20
